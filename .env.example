# Server (bind to localhost only; `tailscale serve` forwards to it)
PORT=3000
HOST=127.0.0.1
# Optional: if set, every request must send this password (header x-password or cookie)
APP_PASSWORD=

# Binaries and models
FFMPEG=ffmpeg
WHISPER_CLI=bin/whisper/Release/whisper-cli.exe
WHISPER_MODEL=models/ggml-typhoon-large-v3-q8_0.bin
VAD_MODEL=models/ggml-silero-v6.2.0.bin
VAD_SEGMENTS_BIN=bin/whisper/Release/whisper-vad-speech-segments.exe

# chunked = cut at pauses and transcribe each piece (needed for Typhoon Whisper, which emits no timestamps)
# direct  = whole file in one pass (for models with timestamps, e.g. large-v3-turbo)
# docs/vad-test-plan.md + data/eval/results.md: chunked + dropping silences >= 2 s was best (CER 15-17%)
# spoken language: th | en | zh | ... | auto (Typhoon Whisper is tuned for Thai; check other languages before relying on it)
WHISPER_LANG=th
WHISPER_MODE=chunked
CHUNK_SECONDS=25
DROP_SILENCE_SECONDS=2
# never set true: sending silence to Whisper made it invent text (insertions x4)
KEEP_SILENCE=false
LLAMA_BIN=bin/llama/llama-completion.exe
LLM_MODEL=models/typhoon2.5-qwen3-4b-q4_k_m.gguf

# LLM settings
LLM_CTX=8192
LLM_TEMP=0.2
# Transcript is split into chunks of this many minutes before summarizing
CHUNK_MINUTES=8

# Data (audio is deleted after transcription; KEEP_AUDIO_DAYS=0 means never keep)
DB_PATH=data/app.db
TMP_DIR=data/tmp
KEEP_AUDIO_DAYS=0
MAX_UPLOAD_MB=200
